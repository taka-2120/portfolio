[Unit]
Description=Obsidian MCP Server
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/portfolio/obsidian-mcp-server
EnvironmentFile=/path/to/portfolio/obsidian-mcp-server/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
